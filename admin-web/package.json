{
  "name": "admin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test:e2e": "playwright test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "guard:auth:evidence": "node scripts/auth-evidence-guard.mjs",
    "smoke:auth:live": "node scripts/auth-live-smoke.mjs",
    "smoke:auth:action": "node scripts/auth-live-smoke.mjs --include-action-smoke",
    "smoke:auth:staging": "node scripts/auth-live-smoke.mjs --staging",
    "smoke:auth:staging:action": "node scripts/auth-live-smoke.mjs --staging --include-action-smoke",
    "smoke:auth:staging:token-scope": "node scripts/auth-token-scope-smoke.mjs --staging",
    "smoke:ui": "npm run build && npm run test:e2e",
    "smoke:pilot": "npm run build && playwright test pilot-smoke.spec.ts pilot-api-contracts.spec.ts",
    "check:release": "npm run lint && npm run test:scripts && npm run smoke:ui && npm audit --omit=dev",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/react": "^6.4.7",
    "@tanstack/react-query": "^5.90.5",
    "lucide-react": "^0.542.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
