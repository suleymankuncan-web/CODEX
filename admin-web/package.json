{
  "name": "admin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "node scripts/playwright-build.mjs",
    "build:cloudflare": "tsc -b && vite build --mode cloudflare",
    "upload:cloudflare:artifact": "node scripts/cloudflare-release.mjs upload",
    "promote:cloudflare:version": "node scripts/cloudflare-release.mjs promote",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test:e2e": "node scripts/run-release-e2e.mjs",
    "test:e2e:summary": "node scripts/playwright-summary.mjs",
    "test:e2e:capture": "playwright test",
    "test:e2e:store-contracts": "playwright test store-page-contracts.spec.ts store-checklists-contracts.spec.ts store-vm-campaigns-contracts.spec.ts store-rankings-contracts.spec.ts store-kpis-contracts.spec.ts store-incentives-contracts.spec.ts store-targets-contracts.spec.ts store-workforce-contracts.spec.ts store-tasks-contracts.spec.ts store-feed-contracts.spec.ts store-reports-contracts.spec.ts store-home-contracts.spec.ts store-me-contracts.spec.ts store-personnel-contracts.spec.ts store-report-viewer-persona.spec.ts",
    "test:e2e:store-manager": "playwright test store-manager-persona.spec.ts",
    "test:e2e:store-personnel": "playwright test store-personnel-persona.spec.ts",
    "test:unit": "vitest run",
    "test:scripts": "npm run test:unit && node --test scripts/*.test.mjs",
    "guard:auth:evidence": "node scripts/auth-evidence-guard.mjs",
    "smoke:auth:live": "node scripts/auth-live-smoke.mjs",
    "smoke:auth:action": "node scripts/auth-live-smoke.mjs --include-action-smoke",
    "smoke:auth:staging": "node scripts/auth-live-smoke.mjs --staging",
    "smoke:auth:staging:action": "node scripts/auth-live-smoke.mjs --staging --include-action-smoke",
    "smoke:auth:staging:cookie-session": "node scripts/auth-cookie-session-live-smoke.mjs --staging",
    "smoke:auth:staging:store-manager": "node scripts/auth-store-manager-cookie-session-smoke.mjs --staging",
    "smoke:auth:staging:store-personnel": "node scripts/auth-store-personnel-cookie-session-smoke.mjs --staging",
    "smoke:auth:staging:token-scope": "node scripts/auth-token-scope-smoke.mjs --staging",
    "smoke:store-action:staging:command": "node scripts/store-action-command-smoke.mjs --staging",
    "smoke:ui": "npm run build && npm run test:e2e",
    "smoke:pilot": "npm run build && playwright test pilot-smoke.spec.ts pilot-api-contracts.spec.ts",
    "smoke:pilot:live": "node scripts/pilot-live-smoke.mjs",
    "check:release": "npm run check:release:static && npm run check:release:e2e && npm run check:release:audit",
    "check:release:static": "npm run api:check && npm run lint && npm run test:scripts && npm run build:e2e",
    "check:release:e2e": "npm run test:e2e",
    "check:release:audit": "npm audit --omit=dev",
    "api:generate": "node scripts/generate-openapi-types.mjs",
    "api:check": "node scripts/generate-openapi-types.mjs --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/react": "^6.4.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@sentry/react": "^10.65.0",
    "@tanstack/react-query": "^5.90.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.542.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "js-cookie": "3.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
