{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hr-axis-staging-frontend",
  "compatibility_date": "2026-07-29",
  "routes": [
    {
      "pattern": "staging.hr-axis.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
