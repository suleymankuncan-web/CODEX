APP_PORT=3000
PORT=
APP_NAME=store-ops-backend
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/store_ops
AUTH_MODE=mock
AUTH_PROVIDER_KEY=oidc
ALLOW_MOCK_AUTH=true
MIGRATIONS_HTTP_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
JWT_AUDIENCE=store-ops-api
JWT_ISSUER=store-ops-auth
JWT_SECRET=change-me
JWT_JWKS_URL=
AUTH_AUTHORIZATION_URL=
AUTH_CLIENT_ID=
AUTH_SCOPE=openid profile email
AUTH_RESPONSE_TYPE=code
AUTH_TOKEN_URL=
AUTH_AUDIENCE_OVERRIDE=
AUTH_CALLBACK_PATH=/auth/callback
AUTH_LOGOUT_URL=
AUTH_POST_LOGOUT_REDIRECT_PATH=/auth/login
DB_POOL_MAX=20
DB_SSL_MODE=disable
QUEUE_BACKEND=in-memory
REDIS_URL=redis://localhost:6379
QUEUE_IMPORT_NAME=store-ops-import
QUEUE_SNAPSHOT_NAME=store-ops-snapshot
DAILY_CLOSURE_AUTOMATION_ENABLED=false
DAILY_CLOSURE_POLL_MINUTES=15
DAILY_CLOSURE_ACTOR_USER_ID=00000000-0000-0000-0000-000000000998
