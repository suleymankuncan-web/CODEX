    "not_applicable": { "label": "N/A", "excludedFromDenominator": true }
  },
  "items": [
    { "itemNo": 1, "sectionName": "M\u00fc\u015fteri Hizmetleri", "itemText": "M\u00fc\u015fteriden gelen inceleme \u00fcr\u00fcnlerinin sisteme giri\u015fi yap\u0131lm\u0131\u015f m\u0131?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 2, "sectionName": "M\u00fc\u015fteri Hizmetleri", "itemText": "\u0130ncelemeye/kargoya g\u00f6nderilecek \u00fcr\u00fcnlerin \u00e7\u0131k\u0131\u015f\u0131 zaman\u0131nda yap\u0131lm\u0131\u015f m\u0131?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 3, "sectionName": "M\u00fc\u015fteri Hizmetleri", "itemText": "\u0130nceleme kabul\u00fc olan \u00fcr\u00fcnlerin sistemsel \u00e7\u0131k\u0131\u015flar\u0131 yap\u0131lm\u0131\u015f m\u0131?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 4, "sectionName": "M\u00fc\u015fteri Hizmetleri", "itemText": "M\u00fc\u015fteri \u015fikayetleri ve geri bildirimleri kay\u0131t alt\u0131na al\u0131n\u0131yor, \u00e7\u00f6z\u00fcm ve tekrar\u0131n\u0131 \u00f6nleme aksiyonu takip ediliyor mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 5, "sectionName": "Operasyon", "itemText": "Kamera sistemi \u00e7al\u0131\u015f\u0131yor mu? K\u00f6r nokta mevcut mu?", "responseType": "compliance", "weight": 1, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 6, "sectionName": "Operasyon", "itemText": "M\u00fczik yay\u0131n\u0131 \u00e7al\u0131\u015f\u0131yor mu?", "responseType": "compliance", "weight": 1, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 7, "sectionName": "Operasyon", "itemText": "Ki\u015fi saya\u00e7 sistemi \u00e7al\u0131\u015f\u0131yor mu?", "responseType": "compliance", "weight": 1, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 8, "sectionName": "Operasyon", "itemText": "Ziyaret\u00e7i Analizi ve Say\u0131m sisteminde bulunan y\u00fcz tan\u0131ma ekran\u0131nda t\u00fcm ekip tan\u0131ml\u0131 m\u0131?", "responseType": "compliance", "weight": 1, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 9, "sectionName": "Operasyon", "itemText": "Koku cihaz\u0131 ve \u00fct\u00fc gb. ma\u011faza ekipmanlar\u0131 \u00e7al\u0131\u015f\u0131yor mu?", "responseType": "compliance", "weight": 1, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 10, "sectionName": "Operasyon", "itemText": "Yang\u0131n \u00e7\u0131k\u0131\u015f\u0131, acil durum ekipman\u0131 ve g\u00fcvenlik alanlar\u0131 eri\u015filebilir mi? Skt g\u00fcncel mi?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 11, "sectionName": "Operasyon", "itemText": "Kasa evraklar\u0131 ve g\u00fcnl\u00fck kasa s\u00fcre\u00e7leri eksiksiz mi? Kasa nakit tutar\u0131 ve son dekont kontrol\u00fc do\u011fru mu?(merkez ma\u011fazalar\u0131 i\u00e7in)", "responseType": "compliance", "weight": 3, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 12, "sectionName": "Operasyon", "itemText": "10 g\u00fcn\u00fc ge\u00e7mi\u015f onaylanmam\u0131\u015f irsaliye bulunuyor mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 13, "sectionName": "Operasyon", "itemText": "Ma\u011faza, depo ve kabinler temizlik standard\u0131na uygun mu?", "responseType": "compliance", "weight": 3, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 14, "sectionName": "Operasyon", "itemText": "Ma\u011fazadaki teknik ar\u0131za, bak\u0131m ve eksik ekipmanlar kay\u0131t alt\u0131na al\u0131nm\u0131\u015f ve takip ediliyor mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 15, "sectionName": "Personel", "itemText": "Ma\u011faza norm kadrosu yeterli mi?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 16, "sectionName": "Personel", "itemText": "Eksik kadro varsa tamamlamak i\u00e7in aksiyon plan\u0131 var m\u0131?", "responseType": "compliance", "weight": 1, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 17, "sectionName": "Personel", "itemText": "\u00c7al\u0131\u015fma program\u0131na uyulmu\u015f mu? Ziyaret s\u0131ras\u0131nda ma\u011fazada yeterli say\u0131da \u00e7al\u0131\u015fan var m\u0131?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 18, "sectionName": "Personel", "itemText": "Personel k\u0131yafeti, ki\u015fisel bak\u0131m ve isimlik kullan\u0131m\u0131 standartlara uygun mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 19, "sectionName": "Personel", "itemText": "Personel devaml\u0131l\u0131k, ge\u00e7 kalma ve devams\u0131zl\u0131k problemleri takip edilip aksiyona d\u00f6n\u00fc\u015ft\u00fcr\u00fcl\u00fcyor mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 20, "sectionName": "Personel", "itemText": "Ma\u011faza y\u00f6neticisi ekip \u00fcyelerine d\u00fczenli geri bildirim ve ko\u00e7luk yap\u0131yor mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 21, "sectionName": "Sat\u0131\u015f & M\u00fc\u015fteri", "itemText": "Ma\u011faza y\u00f6neticisi KPI'lara hakim ve ekibiyle d\u00fczenli payla\u015f\u0131yor mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 22, "sectionName": "Sat\u0131\u015f & M\u00fc\u015fteri", "itemText": "Ekip g\u00fcnl\u00fck/haftal\u0131k hedef ve \u00f6nceliklere hakim mi?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 23, "sectionName": "Sat\u0131\u015f & M\u00fc\u015fteri", "itemText": "Ekip kampanyalara ve m\u00fc\u015fteri avantajlar\u0131na (Hopi, Zubizu, Chippin vb.) hakim mi? G\u00f6rselleri mevcut mu?", "responseType": "compliance", "weight": 1, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 24, "sectionName": "Sat\u0131\u015f & M\u00fc\u015fteri", "itemText": "Yeni ba\u015flayan/eksik yetkinli\u011fi olan personel i\u00e7in e\u011fitim ve geli\u015fim takibi yap\u0131l\u0131yor mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 25, "sectionName": "Sat\u0131\u015f & M\u00fc\u015fteri", "itemText": "Ma\u011faza sat\u0131\u015f performans\u0131 hedefe g\u00f6re takip ediliyor ve aksiyonlar belirleniyor mu?", "responseType": "compliance", "weight": 3, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 26, "sectionName": "Sat\u0131\u015f & M\u00fc\u015fteri", "itemText": "CR, ATV ve UPT gibi temel KPI'lar takip edilip aksiyona d\u00f6n\u00fc\u015ft\u00fcr\u00fcl\u00fcyor mu?", "responseType": "compliance", "weight": 3, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 27, "sectionName": "Sat\u0131\u015f & M\u00fc\u015fteri", "itemText": "M\u00fc\u015fteri kar\u015f\u0131lama, ihtiya\u00e7 analizi ve \u00fcr\u00fcn \u00f6nerme standartlar\u0131na uyuluyor mu?", "responseType": "compliance", "weight": 3, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 28, "sectionName": "Sat\u0131\u015f & M\u00fc\u015fteri", "itemText": "Kabin y\u00f6netimi ve m\u00fc\u015fteri deneyimi standartlara uygun mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 29, "sectionName": "Sat\u0131\u015f & M\u00fc\u015fteri", "itemText": "Kasa \u00f6n\u00fc, \u00f6deme ve u\u011furlama s\u00fcreci m\u00fc\u015fteri deneyimi a\u00e7\u0131s\u0131ndan uygun mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 30, "sectionName": "Sat\u0131\u015f & M\u00fc\u015fteri", "itemText": "\u0130ade/de\u011fi\u015fim s\u00fcre\u00e7leri do\u011fru ve m\u00fc\u015fteri odakl\u0131 y\u00fcr\u00fct\u00fcl\u00fcyor mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 31, "sectionName": "Sat\u0131\u015f & M\u00fc\u015fteri", "itemText": "Ma\u011faza ekibi CRM/\u00fcyelik/kampanya f\u0131rsatlar\u0131n\u0131 aktif \u015fekilde kullan\u0131yor mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 32, "sectionName": "Stok & \u00dcr\u00fcn", "itemText": "\u00dcr\u00fcnlerde alarm mevcut ve do\u011fru noktalara uygulanm\u0131\u015f m\u0131?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 33, "sectionName": "Stok & \u00dcr\u00fcn", "itemText": "Y\u00f6netici el terminali ile manuel say\u0131m yap\u0131yor ve stok durumuna hakim mi?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 34, "sectionName": "Stok & \u00dcr\u00fcn", "itemText": "Tesad\u00fcfi se\u00e7ilen iki \u00fcr\u00fcn(option) stoklar\u0131 sistemsel ve fiili kontrol edildi mi? Do\u011fru mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 35, "sectionName": "Stok & \u00dcr\u00fcn", "itemText": "Eksik/fazla stok, kay\u0131p veya kritik stok farklar\u0131 i\u00e7in aksiyon al\u0131nm\u0131\u015f m\u0131?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 36, "sectionName": "Stok & \u00dcr\u00fcn", "itemText": "Depo \u00fcr\u00fcn yerle\u015fimi, etiketleme ve \u00fcr\u00fcn bulma kolayl\u0131\u011f\u0131 standartlara uygun mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 37, "sectionName": "Stok & \u00dcr\u00fcn", "itemText": "Transfer, sevkiyat ve ma\u011fazalar aras\u0131 \u00fcr\u00fcn hareketleri zaman\u0131nda ve do\u011fru \u015fekilde y\u00f6netiliyor mu?", "responseType": "compliance", "weight": 3, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 38, "sectionName": "Vitrin & VM", "itemText": "Vitrin mankenleri do\u011fru giydirilmi\u015f mi?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 39, "sectionName": "Vitrin & VM", "itemText": "Kampanya g\u00f6rselleri eksiksiz ve g\u00fcncel mi?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 40, "sectionName": "Vitrin & VM", "itemText": "Vitrin cam\u0131, zemin ve vitrin alan\u0131 temiz mi?", "responseType": "compliance", "weight": 1, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 41, "sectionName": "Vitrin & VM", "itemText": "Vitrin spotlar\u0131 ve di\u011fer ayd\u0131nlatmalar yeterli ve eksiksiz \u00e7al\u0131\u015f\u0131yor mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 42, "sectionName": "Vitrin & VM", "itemText": "Ma\u011faza i\u00e7i yerle\u015fim ve g\u00f6rsel d\u00fczen marka standartlar\u0131na uygun mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 43, "sectionName": "Vitrin & VM", "itemText": "\u00dcr\u00fcnler do\u011fru kat/ask\u0131/masa \u00fczerinde ve beden s\u0131ralamas\u0131 d\u00fczenli mi?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 44, "sectionName": "Vitrin & VM", "itemText": "Ask\u0131daki \u00fcr\u00fcnler \u00fct\u00fcl\u00fc, d\u00fczg\u00fcn ve sat\u0131\u015fa haz\u0131r m\u0131?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 45, "sectionName": "Vitrin & VM", "itemText": "Mankendeki \u00fcr\u00fcnler \u00fct\u00fcl\u00fc ve d\u00fczg\u00fcn m\u00fc?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 46, "sectionName": "Vitrin & VM", "itemText": "Fiyat/indirim etiketleri do\u011fru, g\u00fcncel ve standartlara uygun mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 47, "sectionName": "Vitrin & VM", "itemText": "Haftal\u0131k g\u00f6rsel foto\u011fraflar ilgili ekip ile payla\u015f\u0131lm\u0131\u015f m\u0131?", "responseType": "compliance", "weight": 1, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 48, "sectionName": "Vitrin & VM", "itemText": "I\u015f\u0131kl\u0131 vitrin g\u00f6rselleri \u00e7al\u0131\u015f\u0131r durumda m\u0131?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 49, "sectionName": "Y\u00f6netim", "itemText": "Ma\u011faza y\u00f6neticisi \u00f6nceki b\u00f6lge m\u00fcd\u00fcr\u00fc ziyaretindeki aksiyonlar\u0131 kapatm\u0131\u015f m\u0131?", "responseType": "compliance", "weight": 5, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 },
    { "itemNo": 50, "sectionName": "Y\u00f6netim", "itemText": "Ma\u011faza ekibi ileti\u015fim, motivasyon ve i\u015f birli\u011fi a\u00e7\u0131s\u0131ndan sa\u011fl\u0131kl\u0131 \u00e7al\u0131\u015f\u0131yor mu?", "responseType": "compliance", "weight": 2, "maxScore": 2, "evidencePolicy": "optional", "maxEvidenceCount": 3 }
  ]
}
