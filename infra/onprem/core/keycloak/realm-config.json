{
  "realm": "store-ops",
  "x-hr-axis-fixture-authority": "non-authoritative-bootstrap-parity",
  "x-hr-axis-authoritative": false,
  "enabled": true,
  "displayName": "HR Axis",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "rememberMe": true,
  "roles": {
    "realm": [
      { "name": "SUPER_ADMIN" },
      { "name": "REPORT_VIEWER" },
      { "name": "STORE_MANAGER" },
      { "name": "STORE_PERSONNEL" },
      { "name": "REGION_MANAGER" },
      { "name": "AUDITOR" },
      { "name": "HR_ADMIN" },
      { "name": "INTEGRATION_ADMIN" },
      { "name": "SNAPSHOT_OPERATOR" },
      { "name": "VISUAL_MERCHANDISER" }
    ]
  },
  "clients": [
    {
      "clientId": "store-ops-admin-web",
      "name": "HR Axis browser",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://hr-axis.example.invalid/auth/callback"],
      "webOrigins": ["https://hr-axis.example.invalid"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://hr-axis.example.invalid/auth/login"
      },
      "defaultClientScopes": ["web-origins", "profile", "roles", "email", "basic"],
      "protocolMappers": [
      {
        "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
        }
      },
      {
        "name": "store-ops-api-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": {
          "included.client.audience": "store-ops-api",
          "id.token.claim": "false",
          "access.token.claim": "true",
          "userinfo.token.claim": "false"
        }
      },
        { "name": "employee_id", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false, "config": { "multivalued": "true", "user.attribute": "employee_id", "claim.name": "employee_id", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" } },
        { "name": "company_ids", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false, "config": { "multivalued": "true", "user.attribute": "company_ids", "claim.name": "company_ids", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" } },
        { "name": "region_ids", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false, "config": { "multivalued": "true", "user.attribute": "region_ids", "claim.name": "region_ids", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" } },
        { "name": "store_ids", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false, "config": { "multivalued": "true", "user.attribute": "store_ids", "claim.name": "store_ids", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" } },
        { "name": "read_company_ids", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false, "config": { "multivalued": "true", "user.attribute": "read_company_ids", "claim.name": "read_company_ids", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" } },
        { "name": "read_region_ids", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false, "config": { "multivalued": "true", "user.attribute": "read_region_ids", "claim.name": "read_region_ids", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" } },
        { "name": "read_store_ids", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false, "config": { "multivalued": "true", "user.attribute": "read_store_ids", "claim.name": "read_store_ids", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" } },
        { "name": "assigned_store_ids", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false, "config": { "multivalued": "true", "user.attribute": "assigned_store_ids", "claim.name": "assigned_store_ids", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" } }
      ]
    }
  ]
}
