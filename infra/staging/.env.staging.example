# Public staging hosts.
STAGING_FRONTEND_HOST=staging.hr-axis.com
STAGING_API_HOST=api-staging.hr-axis.com

# Frontend build-time env. Rebuild frontend after changing these values.
VITE_API_BASE_URL=https://api-staging.hr-axis.com/api
VITE_AUTH_MODE=bearer
VITE_AUTH_PROVIDER=clerk
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_JWT_TEMPLATE=hr-axis-api

# Backend runtime env.
NODE_ENV=production
APP_NAME=hr-axis-staging-api
APP_PORT=3000
DATABASE_URL=
DB_POOL_MAX=20
DB_SSL_MODE=require

AUTH_MODE=jwt
AUTH_PROVIDER_KEY=clerk
ALLOW_MOCK_AUTH=false

JWT_ISSUER=
JWT_JWKS_URL=
JWT_AUDIENCE=hr-axis-api
AUTH_CLIENT_ID=

CORS_ALLOWED_ORIGINS=https://staging.hr-axis.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# V1 staging keeps queues in-process. Switch to bullmq only after Redis is provisioned.
QUEUE_BACKEND=in-memory
REDIS_URL=
DAILY_CLOSURE_AUTOMATION_ENABLED=false
INCENTIVE_AUTO_CLOSE_ENABLED=true

